# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

NODE_ENV=development

# Host/port the API server binds to.
PORT=4000
HOST=0.0.0.0

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:5173

# Logging verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://academy:academy@localhost:5432/academy_library?schema=public

# Signs the CSRF double-submit token (see src/middleware/csrf.ts) — not a
# password secret, just needs to be long and unpredictable. Generate your
# own with: openssl rand -hex 32
# Required — the server refuses to start without it.
CSRF_SECRET=changeme-generate-your-own-32-byte-hex-secret-with-openssl

# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME=academy_session

# How long a session stays valid after login, in hours. Fixed/absolute,
# not a sliding expiry — see docs/architecture/authentication.md.
SESSION_TTL_HOURS=720

# Allows/disallows public self-registration (POST /auth/register).
# Optional — unset falls back to "on" everywhere except NODE_ENV=production,
# where it fails safe to "off" (there is no email verification or password
# reset yet, so public self-registration on a production deployment is a
# real abuse surface with no recovery story — see
# docs/architecture/authentication.md, "Known limitations"). Set to
# "true"/"false" explicitly to override that default in either direction.
# REGISTRATION_ENABLED=true

# Cookie SameSite attribute. Optional — defaults to "lax", correct for
# the recommended same-origin topologies (Vite dev proxy, nginx, the
# Vercel-rewrite free-hosting setup — see docs/deployment/free-hosting.md).
# Only set to "none" for a deliberately-unproxied cross-origin deployment
# (frontend and API on genuinely different origins) — pair it with
# VITE_API_BASE_URL set to this API's full origin on the frontend side.
# Forces Secure cookies on regardless of NODE_ENV when set to "none"
# (required by browsers; HTTPS is mandatory for this mode to work at all).
# COOKIE_SAME_SITE=lax

# Optional overrides for `pnpm db:seed`'s three development accounts
# (student@academy.test / lecturer@academy.test / admin@academy.test).
# Each falls back to a documented, obviously-fake default
# ("DevPassword123!") if unset — see docs/architecture/authentication.md
# ("Development accounts"). Never set these to anything resembling a
# real credential; `pnpm db:seed` refuses to run at all when
# NODE_ENV=production regardless.
# SEED_STUDENT_PASSWORD=
# SEED_LECTURER_PASSWORD=
# SEED_ADMIN_PASSWORD=

# Optional overrides for `pnpm db:seed:public-demo` (prisma/seedPublicDemo.ts)
# — the production-safe, one-time initializer for a public deployment, NOT
# the dev seed above. DEMO_ADMIN_EMAIL is just an identifier, fine to leave
# at its default. DEMO_ADMIN_PASSWORD is never defaulted: leave it unset to
# have a strong random password generated and printed once (never stored —
# write it down immediately), or set it yourself to skip that prompt. See
# that script's own doc comment and docs/deployment/free-hosting.md.
# DEMO_ADMIN_EMAIL=admin@academy-library.demo
# DEMO_ADMIN_PASSWORD=
