# Copy this file to .env and adjust for local development.
# Vite only exposes variables prefixed with VITE_ to client code.

# Relative on purpose — the dev server proxies /api/* to the local API
# (see vite.config.ts), production serves both through the same nginx
# origin, and the recommended free-hosting topology proxies through a
# Vercel rewrite (see docs/deployment/free-hosting.md) — the browser
# never makes a cross-origin request in any of these. See
# docs/architecture/authentication.md ("Cookie policy") for why that
# matters for session cookies. Point this at an absolute URL only if you
# are deliberately deploying frontend and API on separate origins with
# no rewrite/proxy in front — httpClient.ts automatically switches to
# `credentials: 'include'` when this is absolute, and the API side needs
# `COOKIE_SAME_SITE=none` set to match (apps/api/.env.example).
VITE_API_BASE_URL=/api/v1
