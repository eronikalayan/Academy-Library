# Variables consumed by compose.yaml when running `docker compose up`.
# Copy to .env and adjust as needed. Per-app local development (pnpm dev)
# uses apps/api/.env and apps/web/.env instead — see their own .env.example.

POSTGRES_USER=academy
POSTGRES_PASSWORD=academy
POSTGRES_DB=academy_library
POSTGRES_PORT=5432

API_PORT=4000
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Required by the api service — the server refuses to start without it.
# Generate your own with: openssl rand -hex 32
CSRF_SECRET=changeme-generate-your-own-32-byte-hex-secret-with-openssl
SESSION_COOKIE_NAME=academy_session
SESSION_TTL_HOURS=720

WEB_PORT=8080
VITE_API_BASE_URL=/api/v1
