{
  "name": "academy-library",
  "private": true,
  "version": "0.1.0",
  "description": "Academy Library — centralized platform for discovering and managing educational resources.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @academy-library/web dev",
    "dev:api": "pnpm --filter @academy-library/api dev",
    "build": "pnpm --recursive --filter \"./packages/*\" --filter \"./apps/*\" --if-present build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --filter \"./packages/*\" --filter \"./apps/*\" --if-present typecheck",
    "test": "pnpm --recursive --filter \"./packages/*\" --filter \"./apps/*\" --if-present test",
    "test:e2e": "pnpm --filter @academy-library/web test:e2e",
    "clean": "pnpm --recursive exec rm -rf dist node_modules/.vite",
    "db:generate": "pnpm --filter @academy-library/api db:generate",
    "db:migrate": "pnpm --filter @academy-library/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @academy-library/api db:migrate:deploy",
    "db:studio": "pnpm --filter @academy-library/api db:studio",
    "db:seed": "pnpm --filter @academy-library/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
